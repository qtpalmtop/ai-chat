# ===== HTTP =====
PORT=3001

# ===== 数据库（PostgreSQL via Docker）=====
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=doubao
DB_PASSWORD=doubao_pwd
DB_NAME=doubao_ai

# ===== 业务常量 =====
# 用户静默 30s 自动结束会话
USER_INACTIVITY_TIMEOUT_MS=30000
# 历史会话保留 24h
HISTORY_RETENTION_MS=86400000
# 单客服最多 200 条历史
HISTORY_MAX_PER_AGENT=200
# 收到用户消息 → 推送推荐话术的延迟
SUGGESTION_DELAY_MS=1500
# 心跳间隔（必须 < USER_INACTIVITY_TIMEOUT_MS / 3，避免误判）
HEARTBEAT_INTERVAL_MS=25000

# ===== CORS =====
CORS_ORIGIN=*

# ===== App WebView =====
# 当前指向 Vue 版用户端 IM：vue-version Koa SSR（端口 3003）
# vue-version 独立服务：`cd vue-version && npm run dev` 启动
# 切回 React 版：把端口改回 3001（NestJS 自身 SSR 渲染 React 客户端）
# dev 模拟器内 localhost 指代宿主机
# 真机调试需改成 Mac 的 LAN IP（http://<Mac-LAN-IP>:3003/）
# prod 改成线上域名
WEBVIEW_BASE_URL=http://localhost:3003/
